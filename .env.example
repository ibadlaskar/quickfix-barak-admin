# Set these in Netlify: Site configuration > Environment variables
# Supabase: Project > Connect > "Transaction pooler" connection string (port 6543). Put your real password in, URL-encoded.
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SESSION_SECRET=paste-a-random-string-of-at-least-32-characters
SETUP_TOKEN=choose-a-private-setup-password-12+chars
